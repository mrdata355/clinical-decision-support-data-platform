# Runtime mode
APP_ENV=dev
DEMO_MODE=true
LOG_LEVEL=INFO

# Source API connection
# These are project-owned defaults. Replace with the actual internal base URL and resource paths.
SOURCE_API_BASE_URL=https://api.example.internal
SOURCE_API_TOKEN=replace-me
SOURCE_API_HEALTH_PATH=/health/time
SOURCE_PRODUCT_EVENTS_PATH=/v1/product-events
SOURCE_CLINICAL_TOOLS_PATH=/v1/clinical-tools
SOURCE_CONTENT_PATH=/v1/content
SOURCE_ACCOUNTS_PATH=/v1/accounts
SOURCE_PAYMENTS_PATH=/v1/payments
SOURCE_PAGE_SIZE=500
SOURCE_TIMEOUT_SECONDS=30
SOURCE_MAX_PAGES=20000

# Snowflake
SNOWFLAKE_ACCOUNT=org-account
SNOWFLAKE_USER=service_user
SNOWFLAKE_PASSWORD=replace-me
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=CLINICAL_ANALYTICS
SNOWFLAKE_SCHEMA=RAW
SNOWFLAKE_ROLE=DATA_ENGINEER
SNOWFLAKE_QUERY_TAG=clinical-data-platform

# Airflow
AIRFLOW_CONN_SNOWFLAKE_CLINICAL_ANALYTICS=snowflake://service_user:replace-me@org-account/CLINICAL_ANALYTICS/RAW?warehouse=COMPUTE_WH&role=DATA_ENGINEER
CLINICAL_DATA_ENVIRONMENT=dev
AIRFLOW__CORE__LOAD_EXAMPLES=False

# dbt
DBT_PROFILES_DIR=./dbt
DBT_TARGET=dev
DBT_SNOWFLAKE_ACCOUNT=org-account
DBT_SNOWFLAKE_USER=service_user
DBT_SNOWFLAKE_PASSWORD=replace-me
DBT_SNOWFLAKE_ROLE=DATA_ENGINEER
DBT_SNOWFLAKE_DATABASE=CLINICAL_ANALYTICS
DBT_SNOWFLAKE_WAREHOUSE=COMPUTE_WH

# Storage / replay
RAW_URI=s3://clinical-platform-dev/raw
CLEAN_URI=s3://clinical-platform-dev/clean
QUARANTINE_URI=s3://clinical-platform-dev/quarantine
CHECKPOINT_URI=s3://clinical-platform-dev/checkpoints

# Demo / stream console
STREAM_WINDOW_MINUTES=10
STREAM_POLL_SECONDS=5
DEMO_CUSTOMER_COUNT=24
DEMO_PAYMENT_FAILURE_RATE=0.08
